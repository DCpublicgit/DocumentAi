LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434/v1
# Only needed for the provider comparison (see docs/EVAL_RUNBOOK.md) — leave
# blank until you're actually running that provider.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
DATABASE_URL=postgresql://policy:policy@localhost:5432/policy
TOP_K=5
# Refusal gate. Two scales, two values — see docs/DATA_CONTRACT.md "Retrieval".
SCORE_THRESHOLD=0.35            # used when RERANK_ENABLED=false (cosine)
RERANK_SCORE_THRESHOLD=0.5      # used when RERANK_ENABLED=true (cross-encoder)
# Query expansion runs on its own provider so an Ollama-only or hosted-provider
# deployment doesn't silently require an Anthropic key on every question.
QUERY_EXPANSION_PROVIDER=anthropic
POLICY_DIR=/app/policies
CHUNK_SIZE_TOKENS=500
EMBED_BATCH_SIZE=32
RETRIEVAL_CANDIDATE_N=20
LLM_MAX_TOKENS=1024
# Pre-retrieval gibberish gate (app.query_guard) — see docs/DATA_CONTRACT.md
# "Gibberish gate". Longest run of consecutive consonants (any single
# letters-only token, any script) before input is refused without ever
# reaching retrieval. Keep this at 5 or above: 4 flags real Mongolian words
# ("идэвхждэг") and common security-domain acronyms ("CVSS").
GIBBERISH_MAX_CONSONANT_RUN=5
